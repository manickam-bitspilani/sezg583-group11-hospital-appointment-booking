# Passwords are Docker secrets: the container env holds only the file path
$ docker inspect hospital-booking-slot-service-1 --format '{{json .Config.Env}}' | grep PASSWORD
"DB_PASSWORD_FILE=/run/secrets/slot_db_password"
$ docker inspect hospital-booking-patient-service-1 --format '{{json .Config.Env}}' | grep PASSWORD
["DB_PASSWORD_FILE=/run/secrets/patient_db_password"
$ docker inspect hospital-booking-booking-service-1 --format '{{json .Config.Env}}' | grep PASSWORD
"DB_PASSWORD_FILE=/run/secrets/booking_db_password"
$ docker inspect hospital-booking-notification-service-1 --format '{{json .Config.Env}}' | grep PASSWORD
"DB_PASSWORD_FILE=/run/secrets/notification_db_password"

# Secret files mounted read-only inside the container
$ docker compose exec booking-service ls -l /run/secrets/
total 4
-rw-r--r-- 1 app app 33 Oct 31 22:20 booking_db_password

# No password, .env or secrets/ in any image
$ docker history --no-trunc hospital-booking/slot-service:1.0 | grep -ciE 'password|secret'
0
$ docker run --rm --entrypoint ls hospital-booking/slot-service:1.0 -a /app
. .. common.py database.py main.py models.py requirements.txt reservation_schemas.py reservation_service.py schemas.py slot_service.py 
$ docker history --no-trunc hospital-booking/patient-service:1.0 | grep -ciE 'password|secret'
0
$ docker run --rm --entrypoint ls hospital-booking/patient-service:1.0 -a /app
. .. common.py database.py main.py models.py patient_service.py requirements.txt schemas.py 
$ docker history --no-trunc hospital-booking/booking-service:1.0 | grep -ciE 'password|secret'
0
$ docker run --rm --entrypoint ls hospital-booking/booking-service:1.0 -a /app
. .. booking_service.py common.py database.py main.py models.py requirements.txt schemas.py 
$ docker history --no-trunc hospital-booking/notification-service:1.0 | grep -ciE 'password|secret'
0
$ docker run --rm --entrypoint ls hospital-booking/notification-service:1.0 -a /app
. .. common.py database.py main.py models.py notification_service.py requirements.txt schemas.py 

# Not committed to git
$ git check-ignore -v secrets/booking_db_password.txt services/bookingService/.env
.gitignore:11:secrets/	secrets/booking_db_password.txt
services/bookingService/.gitignore:11:.env	services/bookingService/.env

