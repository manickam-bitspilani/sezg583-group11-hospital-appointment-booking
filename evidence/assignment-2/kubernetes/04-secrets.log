# 2026-11-02T17:34:37Z  ./scripts/k8s/demo.sh secrets
# Passwords: one Secret, each pod mounts only its own key as a file
$ kubectl -n hospital-booking get secret db-passwords -o json | jq -c '.data | keys'
["booking_db_password","notification_db_password","patient_db_password","postgres_password","slot_db_password"]

$ kubectl -n hospital-booking exec deploy/booking-service -c booking-service -- ls /run/secrets
booking_db_password

$ kubectl -n hospital-booking exec deploy/booking-service -c booking-service -- env | grep DB_
DB_NAME=booking_db
DB_USER=booking_svc
DB_PASSWORD_FILE=/run/secrets/booking_db_password
DB_HOST=postgres

$ kubectl -n hospital-booking exec deploy/booking-service -c booking-service -- id
uid=10001(app) gid=10001(app) groups=10001(app)

$ kubectl -n hospital-booking get deployment booking-service -o jsonpath='{range .spec.template.spec.containers[0]}readiness: {.readinessProbe.httpGet.path}{"\n"}liveness: tcp {.livenessProbe.tcpSocket.port}{"\n"}resources: {.resources}{"\n"}{end}'
readiness: /health
liveness: tcp 8003
resources: {"limits":{"cpu":"500m","memory":"256Mi"},"requests":{"cpu":"100m","memory":"128Mi"}}

