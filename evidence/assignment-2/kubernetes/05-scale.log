# 2026-11-02T17:34:49Z  ./scripts/k8s/demo.sh scale
# Scale patient-service from 1 to 3 replicas; the Service balances across them
$ kubectl -n hospital-booking scale deployment/patient-service --replicas=3
deployment.apps/patient-service scaled

