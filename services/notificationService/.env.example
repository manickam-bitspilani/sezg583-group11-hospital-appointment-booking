HOST=127.0.0.1
PORT=8004
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_db
DB_USER=notification_svc
DB_PASSWORD=notification_pw

# Mock provider behaviour (also changeable at runtime via PUT /api/v1/simulation)
NOTIFICATION_FAILURE_RATE=0
NOTIFICATION_LATENCY_MS=0

# How long a retry waits for an in-flight delivery of the same key (seconds)
NOTIFICATION_IN_PROGRESS_WAIT_SECONDS=1.5

# Fail exactly this many upcoming sends, then fall back to the failure rate
# (repeatable demos; also settable at runtime via PUT /api/v1/simulation)
NOTIFICATION_FAIL_NEXT=0