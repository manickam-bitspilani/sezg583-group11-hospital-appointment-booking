# Optional, non-secret settings for docker compose (copy to .env to change them).
# Passwords are NOT set here: they are Docker secrets in secrets/*.txt,
# created by ./scripts/docker/generate_secrets.sh and never committed.

LOG_LEVEL=INFO

# BR12: no-shows after which a patient is blocked from booking
NO_SHOW_LIMIT=3

# Mock SMS provider behaviour (also changeable at runtime via PUT /api/v1/simulation)
NOTIFICATION_FAILURE_RATE=0
NOTIFICATION_LATENCY_MS=0
NOTIFICATION_FAIL_NEXT=0
