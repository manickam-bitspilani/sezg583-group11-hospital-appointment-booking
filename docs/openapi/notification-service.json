  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "database"
        ],
        "title": "HealthResponse"
      },
      "NotificationRequest": {
        "properties": {
          "patient_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Patient Id"
          },
          "booking_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Booking Id"
          },
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          },
          "notification_type": {
            "type": "string",
            "pattern": "^(SMS|EMAIL)$",
            "title": "Notification Type"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "message",
          "notification_type"
        ],
        "title": "NotificationRequest"
      },
      "NotificationResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "patient_id": {
            "type": "integer",
            "title": "Patient Id"
          },
          "booking_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Booking Id"
          },
          "notification_type": {
            "type": "string",
            "title": "Notification Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "booking_id",
          "notification_type",
          "message",
          "status",
          "attempts",
          "correlation_id",
          "created_at",
          "sent_at"
        ],
        "title": "NotificationResponse"
      },
      "SimulationSettings": {
        "properties": {
          "failure_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Failure Rate",
            "description": "Probability that a send attempt fails.",
            "default": 0.0
          },
          "latency_ms": {
            "type": "integer",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "description": "Delay added to every send attempt.",
            "default": 0
          },
          "fail_next": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fail Next",
            "description": "Fail exactly this many upcoming send attempts, then fall back to failure_rate.",
            "default": 0
          }
        },
        "type": "object",
        "title": "SimulationSettings",
        "description": "Behaviour of the mock SMS/e-mail provider."
      }
    }
  }
}
