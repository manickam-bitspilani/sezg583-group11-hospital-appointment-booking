    "/api/v1/patients/{patient_id}/no-shows": {
      "post": {
        "summary": "Record No Show",
        "description": "BR12  Record a missed appointment (by front-desk staff). At NO_SHOW_LIMIT\n      no-shows the patient is blocked automatically.",
        "operationId": "record_no_show_api_v1_patients__patient_id__no_shows_post",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Patient Id"
            }
