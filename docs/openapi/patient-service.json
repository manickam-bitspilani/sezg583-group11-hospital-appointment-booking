  "components": {
    "schemas": {
      "EligibilityResponse": {
        "properties": {
          "patient_id": {
            "type": "integer",
            "title": "Patient Id"
          },
          "eligible": {
            "type": "boolean",
            "title": "Eligible"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "eligible"
        ],
        "title": "EligibilityResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "database"
        ],
        "title": "HealthResponse"
      },
      "NoShowCreate": {
        "properties": {
          "booking_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Booking Id"
          }
        },
        "type": "object",
        "required": [
          "booking_id"
        ],
        "title": "NoShowCreate"
      },
      "PatientCreate": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Full Name"
          },
          "age": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Age"
          },
          "phone": {
            "type": "string",
            "maxLength": 15,
            "minLength": 10,
            "pattern": "^\\+?[0-9]{10,14}$",
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "full_name",
          "age",
          "phone"
        ],
        "title": "PatientCreate"
      },
      "PatientResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "age": {
            "type": "integer",
            "title": "Age"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "no_show_count": {
            "type": "integer",
            "title": "No Show Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "age",
          "phone",
          "status",
          "no_show_count"
        ],
        "title": "PatientResponse"
      }
    }
  }
